# Regenerated by docket.
filters:
  and:
    - or:
      - file.inFolder("HARBOR")
    - 'note.status_category == "todo"'
    - 'note.type != "subtask"'
properties:
  note.key:
    displayName: Key
  note.title:
    displayName: Title
  note.type:
    displayName: Type
  note.priority:
    displayName: Priority
  note.parent:
    displayName: Parent
  note.labels:
    displayName: Labels
views:
  - type: table
    name: Backlog
    order:
      - note.key
      - note.title
      - note.type
      - note.priority
      - note.parent
      - note.labels
