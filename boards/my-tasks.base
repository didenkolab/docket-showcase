# Regenerated by docket. Change the assignee below to your own handle.
filters:
  and:
    - or:
      - file.inFolder("HARBOR")
    - 'note.assignee == "agent/claude"'
    - 'note.status_category != "done"'
properties:
  note.key:
    displayName: Key
  note.title:
    displayName: Title
  note.status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.updated:
    displayName: Updated
views:
  - type: table
    name: My tasks
    order:
      - note.key
      - note.title
      - note.status
      - note.priority
      - note.updated
