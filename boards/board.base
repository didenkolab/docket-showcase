# Regenerated by docket. Projects are named explicitly; run
# "docket project add" to add one and rewrite these filters.
filters:
  and:
    - or:
      - file.inFolder("HARBOR")
      - file.inFolder("LEDGER")
      - file.inFolder("FIELD")
    - 'note.status_category != "done"'
formulas:
  stage: 'if(note.status == "Backlog", "1. Backlog", if(note.status == "Ready", "2. Ready", if(note.status == "In progress", "3. In progress", if(note.status == "In review", "4. In review", if(note.status == "QA", "5. QA", if(note.status == "Done", "6. Done", if(note.status == "Cancelled", "7. Cancelled", "")))))))'
properties:
  formula.stage:
    displayName: Stage
  note.title:
    displayName: Title
  note.assignee:
    displayName: Assignee
  note.priority:
    displayName: Priority
  note.estimate:
    displayName: Size
  note.tags:
    displayName: Tags
views:
  - type: cards
    name: Board
    groupBy:
      property: formula.stage
      direction: ASC
    order:
      - note.title
      - note.assignee
      - note.priority
      - note.estimate
      - note.labels
      - note.tags
