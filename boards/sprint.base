# Regenerated by docket. The sprint board exists because a task carries
# its sprint as a property: Bases can only filter on what the note itself says.
filters:
  and:
    - or:
      - file.inFolder("HARBOR")
      - file.inFolder("LEDGER")
      - file.inFolder("FIELD")
    - 'note.sprint'
formulas:
  stage: 'if(note.status == "Backlog", "1. Backlog", if(note.status == "Ready", "2. Ready", if(note.status == "In progress", "3. In progress", if(note.status == "In review", "4. In review", if(note.status == "Done", "5. Done", if(note.status == "Dropped", "6. Dropped", ""))))))'
properties:
  formula.stage:
    displayName: Stage
  note.sprint:
    displayName: Sprint
  note.title:
    displayName: Title
  note.estimate:
    displayName: Size
  note.assignee:
    displayName: Assignee
views:
  - type: cards
    name: Sprint
    groupBy:
      property: note.sprint
      direction: DESC
    order:
      - note.title
      - formula.stage
      - note.estimate
      - note.assignee
  - type: table
    name: By stage
    groupBy:
      property: formula.stage
      direction: ASC
    order:
      - note.key
      - note.title
      - note.sprint
      - note.estimate
      - note.assignee
